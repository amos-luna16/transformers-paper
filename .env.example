# Modal credentials (https://modal.com/settings/tokens)
MODAL_TOKEN_ID=ak-xxxxxxxxxxxxxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxxxxxxxxx
MODAL_PROFILE=your-workspace

# Modal compute (see README "Choosing a GPU")
MODAL_GPU=A100-40GB
MODAL_GPU_COUNT=2
MODAL_INFERENCE_GPU=T4

# Training overrides (all optional; defaults live in src/transformer_nmt/config.py)
TRAINING_EPOCHS=25
TRAINING_BATCH_SIZE=128
TRAINING_PRECISION=auto

# Experiment tracking
TRACKING_EXPERIMENT_NAME=transformer-nmt-eng-fra
